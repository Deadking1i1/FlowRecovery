# Copy to .env.local for local development. Never commit real credentials.

# Current runtime configuration
NODE_ENV=development
CRON_SECRET=replace_with_a_long_random_secret
REMINDER_DELIVERY=disabled
ALLOW_EXTERNAL_SEND=false

# The current app reports these values from /api/health. Keep billing and
# reminder delivery fail-closed in every non-production environment.
BILLING_MODE=test
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me
STRIPE_PRICE_ID=

# Current Supabase integration. The service-role key is server-only; the
# NEXT_PUBLIC values are safe client configuration, not authentication secrets.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Reserved for future integrations; not consumed by the current CSV workflow.
APP_URL=http://localhost:3000
DATABASE_URL=
AUTH_SECRET=
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=http://localhost:3000/api/integrations/xero/callback

